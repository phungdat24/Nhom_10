<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.ScrollPane?>
<AnchorPane prefHeight="720.0" prefWidth="1400.0" styleClass="auction-session-root" stylesheets="@../../css/admin.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nhomX.example.controller.admin.AuctionSessionController">

    <VBox spacing="22" AnchorPane.leftAnchor="28" AnchorPane.rightAnchor="28" AnchorPane.topAnchor="28" AnchorPane.bottomAnchor="28">

        <!-- HEADER -->
        <HBox alignment="CENTER_LEFT" spacing="16">
            <VBox spacing="6">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label fx:id="liveBadgeLabel" styleClass="auction-live-badge" text="● Live: 0 Sessions" />
                </HBox>
                <Label styleClass="auction-page-subtitle" text="Giám sát và điều phối các phiên đấu giá trực tiếp theo thời gian thực" />
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <TextField fx:id="searchField" prefWidth="360" promptText="Tìm kiếm phiên hoặc sản phẩm..." styleClass="auction-search-input" />
        </HBox>

        <!-- STATS -->
        <HBox spacing="18">
            <VBox HBox.hgrow="ALWAYS" spacing="10" styleClass="auction-stat-card">
                <Label styleClass="auction-stat-label" text="Tổng doanh thu" />
                <Label fx:id="totalRevenueLabel" styleClass="auction-stat-value" text="0 VNĐ" />
                <Label styleClass="auction-stat-success" text="↗ Theo thời gian thực" />
            </VBox>

            <VBox HBox.hgrow="ALWAYS" spacing="10" styleClass="auction-stat-card">
                <Label styleClass="auction-stat-label" text="Lượt đấu giá" />
                <Label fx:id="totalBidsLabel" styleClass="auction-stat-value" text="1,284" />
                <Label styleClass="auction-stat-muted" text="Tổng lượt đặt giá" />
            </VBox>

            <VBox HBox.hgrow="ALWAYS" spacing="10" styleClass="auction-stat-card">
                <Label styleClass="auction-stat-label" text="Phiên đang Live" />
                <Label fx:id="liveSessionsLabel" styleClass="auction-stat-value" text="0" />
                <StackPane prefHeight="6" styleClass="auction-progress-track">
                    <Region prefWidth="185" styleClass="auction-progress-fill" StackPane.alignment="CENTER_LEFT" />
                </StackPane>
            </VBox>
        </HBox>

        <!-- AUCTION TABLE -->
        <VBox styleClass="auction-table-card">

            <HBox alignment="CENTER_LEFT" styleClass="auction-table-header">
                <Label prefWidth="145" styleClass="auction-header-cell" text="MÃ PHIÊN" />
                <Label prefWidth="370" styleClass="auction-header-cell" text="TÊN SẢN PHẨM" />
                <Label fx:id="sortPriceHeader" prefWidth="230" styleClass="auction-header-cell" text="GIÁ TRẦN HIỆN TẠI ↕" style="-fx-cursor: hand;" />
                <Label prefWidth="220" styleClass="auction-header-cell" text="NGƯỜI GIỮ TOP 1" />
                <Label fx:id="sortTimeHeader" prefWidth="150" styleClass="auction-header-cell" text="THỜI GIAN ↕" style="-fx-cursor: hand;" />
                <Label prefWidth="150" styleClass="auction-header-cell" text="THAO TÁC" />
            </HBox>

            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="tableBody" />
                </content>
            </ScrollPane>
            <HBox alignment="CENTER_LEFT" styleClass="auction-table-footer">
                <Label fx:id="pageInfoLabel" styleClass="auction-footer-text" text="Đang tải dữ liệu..." />
                <Region HBox.hgrow="ALWAYS" />
                <Button styleClass="auction-page-button" text="‹" />
                <Button styleClass="auction-page-active" text="1" />
                <Button styleClass="auction-page-button" text="2" />
                <Button styleClass="auction-page-button" text="3" />
                <Button styleClass="auction-page-button" text="›" />
            </HBox>

        </VBox>
    </VBox>
</AnchorPane>
