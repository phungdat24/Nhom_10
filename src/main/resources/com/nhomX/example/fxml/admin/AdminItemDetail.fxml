<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIcon?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="768.0" prefWidth="1224.0" styleClass="admin-item-detail-page" stylesheets="@../../css/admin.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nhomX.example.controller.admin.AdminItemDetailController">

    <Button fx:id="btnBack" onAction="#handleBackAction" styleClass="admin-item-detail-back-button" text="←  Quay lại" AnchorPane.leftAnchor="32" AnchorPane.topAnchor="24" />

    <HBox styleClass="admin-item-detail-container" AnchorPane.bottomAnchor="32" AnchorPane.leftAnchor="32" AnchorPane.rightAnchor="32" AnchorPane.topAnchor="82">

        <VBox prefWidth="560" spacing="24" styleClass="admin-item-detail-left-pane">

            <StackPane styleClass="admin-item-detail-image-frame">
                <Label styleClass="admin-item-detail-auth-badge" text="Xác thực thật" StackPane.alignment="TOP_LEFT" />

                <ImageView fx:id="imgMain" fitHeight="410" fitWidth="500" preserveRatio="true" smooth="true" styleClass="admin-item-detail-main-image-view">
                    <image>
                        <Image url="@../../images/watch-main.png" />
                    </image>
                </ImageView>
            </StackPane>

            <HBox spacing="18">
                <StackPane styleClass="admin-item-detail-thumb-frame-active">
                    <ImageView fitHeight="88" fitWidth="88" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@../../images/watch-main.png" />
                        </image>
                    </ImageView>
                </StackPane>

                <StackPane styleClass="admin-item-detail-thumb-frame">
                    <ImageView fitHeight="88" fitWidth="88" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@../../images/watch-strap.png" />
                        </image>
                    </ImageView>
                </StackPane>

                <StackPane styleClass="admin-item-detail-thumb-frame">
                    <ImageView fitHeight="88" fitWidth="88" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@../../images/watch-detail.png" />
                        </image>
                    </ImageView>
                </StackPane>
            </HBox>
        </VBox>

        <VBox prefWidth="570" spacing="22" styleClass="admin-item-detail-right-pane">

            <HBox alignment="TOP_LEFT">
                <VBox spacing="8">
                    <Label fx:id="lblTitle" styleClass="admin-item-detail-title" text="Luxury Chronograph Limited" />
                    <Label fx:id="lblCode" styleClass="admin-item-detail-code" text="MÃ SP: #AUC-89210" />
                </VBox>
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnClose" onAction="#handleCloseAction" styleClass="admin-item-detail-close-button" text="×" />
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="admin-item-detail-seller-box">
                <StackPane styleClass="admin-item-detail-avatar">
                    <Label fx:id="lblAvatarText" styleClass="admin-item-detail-avatar-text" text="NA" />
                </StackPane>

                <VBox spacing="4">
                    <Label fx:id="lblSellerName" styleClass="admin-item-detail-seller-name" text="Nguyễn Văn A" />
                    <Label styleClass="admin-item-detail-seller-sub" text="Thành viên Kim cương • 98% Tin cậy" />
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <VBox alignment="CENTER_RIGHT" spacing="4">
                    <Label styleClass="admin-item-detail-muted" text="NGÀY GỬI" />
                    <Label fx:id="lblSubmitDate" styleClass="admin-item-detail-date" text="12/10/2023" />
                </VBox>
            </HBox>

            <VBox spacing="10">
                <Label styleClass="admin-item-detail-section-title" text="Mô tả sản phẩm" />
                <Label fx:id="lblDescription" styleClass="admin-item-detail-description" text="Phiên bản giới hạn 500 chiếc toàn cầu. Vỏ thép không gỉ 316L, mặt kính Sapphire chống trầy xước. Tình trạng mới 98%, đầy đủ hộp và giấy tờ bảo hành chính hãng." wrapText="true" />
            </VBox>

            <HBox spacing="20">
                <VBox prefWidth="255" spacing="8" styleClass="admin-item-detail-info-card">
                    <Label styleClass="admin-item-detail-muted" text="GIÁ KHỞI ĐIỂM" />
                    <Label fx:id="lblStartingPrice" styleClass="admin-item-detail-price" text="45.000.000 đ" />
                </VBox>

                <VBox prefWidth="255" spacing="8" styleClass="admin-item-detail-info-card">
                    <Label styleClass="admin-item-detail-muted" text="THỜI GIAN MONG MUỐN" />
                    <Label fx:id="lblDesiredTime" styleClass="admin-item-detail-time" text="20:00 • 15/10" />
                </VBox>
            </HBox>

            <VBox spacing="10">
                <Label styleClass="admin-item-detail-reason-label" text="Lý do từ chối (Bắt buộc)">
                    <graphic>
                        <FontAwesomeIcon fill="#c73e3e" glyphName="INFO_CIRCLE" />
                    </graphic></Label>
                <TextArea fx:id="txtRejectReason" prefHeight="86" promptText="Nhập lý do cụ thể để người bán có thể chỉnh sửa lại sản phẩm..." styleClass="admin-item-detail-reason-area" wrapText="true" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <HBox spacing="20">
                <Button fx:id="btnReject" onAction="#handleRejectAction" prefWidth="190" styleClass="admin-item-detail-reject-btn" text="Từ chối">
                    <graphic>
                        <FontAwesomeIcon fill="#d41f1f" glyphName="BAN" />
                    </graphic></Button>
                <Button fx:id="btnApprove" onAction="#handleApproveAction" prefWidth="320" styleClass="admin-item-detail-approve-btn" text="Duyệt lên sàn">
                    <graphic>
                        <FontAwesomeIcon fill="WHITE" glyphName="CHECK_CIRCLE" />
                    </graphic></Button>
            </HBox>

        </VBox>
    </HBox>
</AnchorPane>