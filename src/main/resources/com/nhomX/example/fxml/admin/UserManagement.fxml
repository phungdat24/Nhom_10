<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720.0" prefWidth="1400.0" styleClass="user-management-root" stylesheets="@../../css/admin.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nhomX.example.controller.admin.UserManagementController">

    <VBox spacing="16" AnchorPane.leftAnchor="28" AnchorPane.rightAnchor="28" AnchorPane.topAnchor="28">

        <!-- FILTER + ACTION BAR -->
        <HBox alignment="CENTER_LEFT" spacing="18" styleClass="user-management-filter-card">
            <Label styleClass="user-management-filter-icon" text="▾" />
            <Label styleClass="user-management-filter-title" text="Bộ lọc thông minh:" />

            <Label styleClass="user-management-field-label" text="Trạng thái:" />
            <ComboBox fx:id="statusComboBox" prefWidth="130" promptText="Tất cả" styleClass="user-management-combo" />

            <Label styleClass="user-management-field-label" text="Vai trò:" />
            <ComboBox fx:id="roleComboBox" prefWidth="160" promptText="Người dùng" styleClass="user-management-combo" />

            <Region HBox.hgrow="ALWAYS" />

            <TextField fx:id="searchField" prefWidth="300" promptText="Tìm kiếm theo Tên/Email..." styleClass="user-management-search-input" />
        </HBox>

        <!-- TABLE-LIKE CARD -->
        <VBox styleClass="user-management-table-card">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" styleClass="user-management-table-header">
                <Label prefWidth="130" styleClass="user-management-header-cell" text="ID" />
                <Label prefWidth="300" styleClass="user-management-header-cell" text="Họ tên" />
                <Label prefWidth="320" styleClass="user-management-header-cell" text="Email" />
                <Label prefWidth="220" styleClass="user-management-header-cell" text="Số dư" />
                <Label prefWidth="230" styleClass="user-management-header-cell" text="Trạng thái" />
                <Label prefWidth="140" styleClass="user-management-header-cell" text="Thao tác" />
            </HBox>

            <!-- DATA ROWS — được render động bởi Controller -->
            <VBox fx:id="tableBody" />

            <!-- Footer / Pagination -->
            <HBox fx:id="paginationBar" alignment="CENTER_LEFT" styleClass="user-management-table-footer">
                <Label fx:id="pageInfoLabel" styleClass="user-management-footer-text" text="Đang xem 1 - 15 của 0 người dùng" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="prevButton" onAction="#handlePrev" styleClass="user-management-page-ghost" text="‹" />
                <!-- Các nút số trang được tạo động -->
                <HBox fx:id="pageNumbersBox" spacing="4" />
                <Button fx:id="nextButton" onAction="#handleNext" styleClass="user-management-page-ghost" text="›" />
            </HBox>

        </VBox>
    </VBox>
</AnchorPane>
