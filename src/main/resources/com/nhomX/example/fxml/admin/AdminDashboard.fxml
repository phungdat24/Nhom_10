<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIcon?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.AreaChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToHeight="true" fitToWidth="true" prefHeight="700.0" prefWidth="800.0"
            style="-fx-background: #0E0E0E; -fx-background-color: #0E0E0E;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nhomX.example.controller.admin.AdminDashboardController">
   <content>
      <VBox prefWidth="800.0" spacing="18.0" style="-fx-background-color: #0E0E0E;">
         <padding><Insets bottom="24.0" left="24.0" right="24.0" top="24.0" /></padding>
         <children>

            <!-- TOP KPI CARDS -->
            <HBox prefHeight="125.0" spacing="18.0">
               <children>
                  <!-- Card 1: Tổng User -->
                  <VBox fx:id="cardUsers" prefWidth="238.0" spacing="14.0"
                        style="-fx-background-color: #161616; -fx-background-radius: 18; -fx-border-color: #2A2724; -fx-border-radius: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.45), 18, 0.15, 0, 7);"
                        HBox.hgrow="ALWAYS">
                     <padding><Insets bottom="18" left="18" right="18" top="18" /></padding>
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 11px; -fx-font-weight: bold;" text="TỔNG SỐ USER" />
                           <Region HBox.hgrow="ALWAYS" />
                           <StackPane prefHeight="32.0" prefWidth="32.0" style="-fx-background-color: #C9A84C; -fx-background-radius: 9;">
                              <children><FontAwesomeIcon fill="WHITE" glyphName="USERS" size="1.15em" /></children>
                           </StackPane>
                        </HBox>
                        <HBox alignment="BOTTOM_LEFT" spacing="10.0">
                           <Label fx:id="labelTotalUsers"
                                  style="-fx-text-fill: #C9A84C; -fx-font-size: 24px; -fx-font-weight: bold;" text="..." />
                           <Region HBox.hgrow="ALWAYS" />
                           <Label fx:id="labelUserGrowth"
                                  style="-fx-text-fill: #2ECC71; -fx-font-size: 12px; -fx-font-weight: bold;" text="" />
                        </HBox>
                     </children>
                  </VBox>

                  <!-- Card 2: Phiên Live -->
                  <VBox fx:id="cardLive" prefWidth="238.0" spacing="14.0"
                        style="-fx-background-color: #161616; -fx-background-radius: 18; -fx-border-color: #2A2724; -fx-border-radius: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.45), 18, 0.15, 0, 7);"
                        HBox.hgrow="ALWAYS">
                     <padding><Insets bottom="18" left="18" right="18" top="18" /></padding>
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 11px; -fx-font-weight: bold;" text="TỔNG SỐ PHIÊN ĐANG LIVE" />
                           <Region HBox.hgrow="ALWAYS" />
                           <StackPane prefHeight="32.0" prefWidth="32.0" style="-fx-background-color: #2ECC71; -fx-background-radius: 9;">
                              <children><FontAwesomeIcon fill="#062E22" glyphName="RSS" size="1.1em" /></children>
                           </StackPane>
                        </HBox>
                        <HBox alignment="BOTTOM_LEFT" spacing="10.0">
                           <Label fx:id="labelLiveAuctions"
                                  style="-fx-text-fill: #C9A84C; -fx-font-size: 24px; -fx-font-weight: bold;" text="..." />
                           <Region HBox.hgrow="ALWAYS" />
                           <Label style="-fx-background-color: rgba(46, 204, 113, 0.16); -fx-background-radius: 8; -fx-text-fill: #2ECC71; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 5 8 5 8;" text="LIVE NOW" />
                        </HBox>
                     </children>
                  </VBox>

                  <!-- Card 3: Dòng tiền -->
                  <VBox fx:id="cardRevenue" prefWidth="238.0" spacing="14.0"
                        style="-fx-background-color: #161616; -fx-background-radius: 18; -fx-border-color: #2A2724; -fx-border-radius: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.45), 18, 0.15, 0, 7);"
                        HBox.hgrow="ALWAYS">
                     <padding><Insets bottom="18" left="18" right="18" top="18" /></padding>
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 11px; -fx-font-weight: bold;" text="TỔNG DÒNG TIỀN LƯU THÔNG" />
                           <Region HBox.hgrow="ALWAYS" />
                           <StackPane prefHeight="32.0" prefWidth="32.0" style="-fx-background-color: #2A2A2A; -fx-background-radius: 9;">
                              <children><FontAwesomeIcon fill="#D1D5DB" glyphName="CREDIT_CARD" size="1.05em" /></children>
                           </StackPane>
                        </HBox>
                        <HBox alignment="BOTTOM_LEFT" spacing="8.0">
                           <Label fx:id="labelTotalRevenue"
                                  style="-fx-text-fill: #C9A84C; -fx-font-size: 22px; -fx-font-weight: bold;" text="..." />
                           <Region HBox.hgrow="ALWAYS" />
                           <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 11px;" text="Dữ liệu thời gian&#10;thực" />
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </HBox>

            <!-- MAIN ANALYTICS -->
            <HBox prefHeight="280.0" spacing="18.0">
               <children>
                  <VBox prefWidth="500.0" spacing="12.0"
                        style="-fx-background-color: #161616; -fx-background-radius: 18; -fx-border-color: #2A2724; -fx-border-radius: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.45), 18, 0.15, 0, 7);"
                        HBox.hgrow="ALWAYS">
                     <padding><Insets bottom="14" left="18" right="18" top="18" /></padding>
                     <children>
                        <HBox alignment="CENTER_LEFT">
                           <Label style="-fx-text-fill: #F0EAD6; -fx-font-size: 18px; -fx-font-weight: bold;" text="Thống kê doanh thu theo ngày" />
                           <Region HBox.hgrow="ALWAYS" />
                           <Label style="-fx-background-color: #252220; -fx-background-radius: 13; -fx-text-fill: #D1D5DB; -fx-font-size: 11px; -fx-padding: 6 14 6 14;" text="7 ngày" />
                           <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 11px; -fx-padding: 6 10 6 10;" text="30 ngày" />
                        </HBox>
                        <!-- AreaChart cần fx:id để inject series từ code -->
                        <AreaChart fx:id="revenueChart" animated="false" createSymbols="true"
                                   legendVisible="false" prefHeight="218.0"
                                   style="-fx-background-color: transparent;">
                           <xAxis><CategoryAxis fx:id="chartXAxis" side="BOTTOM" tickLabelFill="#9CA3AF" tickLength="0.0" /></xAxis>
                           <yAxis><NumberAxis fx:id="chartYAxis" opacity="0.0" side="LEFT" /></yAxis>
                        </AreaChart>
                     </children>
                  </VBox>

                  <!-- Category breakdown -->
                  <VBox prefWidth="235.0" spacing="15.0"
                        style="-fx-background-color: #161616; -fx-background-radius: 18; -fx-border-color: #2A2724; -fx-border-radius: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.45), 18, 0.15, 0, 7);">
                     <padding><Insets bottom="18" left="18" right="18" top="18" /></padding>
                     <children>
                        <Label style="-fx-text-fill: #F0EAD6; -fx-font-size: 17px; -fx-font-weight: bold;"
                               text="Số lượng đấu giá&#10;thành công" wrapText="true" />

                        <!-- Trang sức -->
                        <VBox spacing="7.0">
                           <children>
                              <HBox>
                                 <Label style="-fx-font-size: 11px; -fx-text-fill: #D1D5DB;" text="Trang sức" />
                                 <Region HBox.hgrow="ALWAYS" />
                                 <Label fx:id="labelCatJewelry" style="-fx-font-size: 11px; -fx-font-weight: bold;" text="0" />
                              </HBox>
                              <HBox fx:id="barBgJewelry" prefHeight="8"
                                    style="-fx-background-color: #2A2A2A; -fx-background-radius: 99;">
                                 <Region fx:id="barFillJewelry" prefWidth="0"
                                         style="-fx-background-color: #F0EAD6; -fx-background-radius: 99;" />
                              </HBox>
                           </children>
                        </VBox>

                        <!-- Điện tử -->
                        <VBox spacing="7.0">
                           <children>
                              <HBox>
                                 <Label style="-fx-font-size: 11px; -fx-text-fill: #D1D5DB;" text="Điện tử" />
                                 <Region HBox.hgrow="ALWAYS" />
                                 <Label fx:id="labelCatElec" style="-fx-font-size: 11px; -fx-font-weight: bold;" text="0" />
                              </HBox>
                              <HBox fx:id="barBgElec" prefHeight="8"
                                    style="-fx-background-color: #2A2A2A; -fx-background-radius: 99;">
                                 <Region fx:id="barFillElec" prefWidth="0"
                                         style="-fx-background-color: #C9A84C; -fx-background-radius: 99;" />
                              </HBox>
                           </children>
                        </VBox>

                        <!-- Nghệ thuật -->
                        <VBox spacing="7.0">
                           <children>
                              <HBox>
                                 <Label style="-fx-font-size: 11px; -fx-text-fill: #D1D5DB;" text="Nghệ thuật" />
                                 <Region HBox.hgrow="ALWAYS" />
                                 <Label fx:id="labelCatArt" style="-fx-font-size: 11px; -fx-font-weight: bold;" text="0" />
                              </HBox>
                              <HBox fx:id="barBgArt" prefHeight="8"
                                    style="-fx-background-color: #2A2A2A; -fx-background-radius: 99;">
                                 <Region fx:id="barFillArt" prefWidth="0"
                                         style="-fx-background-color: #E74C3C; -fx-background-radius: 99;" />
                              </HBox>
                           </children>
                        </VBox>

                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                           <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 11px;" text="Hiệu suất tổng thể" />
                           <Region HBox.hgrow="ALWAYS" />
                           <Label fx:id="labelOverallGrowth"
                                  style="-fx-text-fill: #2ECC71; -fx-font-size: 13px; -fx-font-weight: bold;" text="+0%" />
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </HBox>

            <!-- LOWER CARDS -->
            <HBox prefHeight="255.0" spacing="18.0">
               <children>
                  <!-- PieChart -->
                  <VBox prefWidth="235.0" spacing="12.0"
                        style="-fx-background-color: #161616; -fx-background-radius: 18; -fx-border-color: #2A2724; -fx-border-radius: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.45), 18, 0.15, 0, 7);">
                     <padding><Insets bottom="18" left="18" right="18" top="18" /></padding>
                     <children>
                        <Label style="-fx-text-fill: #F0EAD6; -fx-font-size: 17px; -fx-font-weight: bold;" text="Tỉ lệ trạng thái phiên" />
                        <PieChart fx:id="statusPieChart" labelsVisible="false"
                                  legendVisible="false" prefHeight="145.0" />
                        <HBox>
                           <Label style="-fx-text-fill: #F0EAD6; -fx-font-size: 11px;" text="● Live" />
                           <Region HBox.hgrow="ALWAYS" />
                           <Label fx:id="labelPieLive" style="-fx-font-size: 11px; -fx-font-weight: bold;" text="0%" />
                        </HBox>
                        <HBox>
                           <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 11px;" text="● Chờ Duyệt" />
                           <Region HBox.hgrow="ALWAYS" />
                           <Label fx:id="labelPiePending" style="-fx-font-size: 11px; -fx-font-weight: bold;" text="0%" />
                        </HBox>
                        <HBox>
                           <Label style="-fx-text-fill: #888070; -fx-font-size: 11px;" text="● Đã Đóng" />
                           <Region HBox.hgrow="ALWAYS" />
                           <Label fx:id="labelPieClosed" style="-fx-font-size: 11px; -fx-font-weight: bold;" text="0%" />
                        </HBox>
                     </children>
                  </VBox>

                  <!-- Recent Transactions GridPane -->
                  <VBox prefWidth="500.0" spacing="12.0"
                        style="-fx-background-color: #161616; -fx-background-radius: 18; -fx-border-color: #2A2724; -fx-border-radius: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.45), 18, 0.15, 0, 7);"
                        HBox.hgrow="ALWAYS">
                     <padding><Insets bottom="18" left="18" right="18" top="18" /></padding>
                     <children>
                        <HBox alignment="CENTER_LEFT">
                           <Label style="-fx-text-fill: #F0EAD6; -fx-font-size: 17px; -fx-font-weight: bold;" text="Giao dịch gần đây" />
                           <Region HBox.hgrow="ALWAYS" />
                           <Label style="-fx-text-fill: #F0EAD6; -fx-font-size: 10px; -fx-font-weight: bold;" text="Xem tất cả" />
                        </HBox>

                        <!-- fx:id trên GridPane để inject rows từ code -->
                        <GridPane fx:id="transactionGrid" hgap="12" vgap="12">
                           <columnConstraints>
                              <ColumnConstraints percentWidth="16" />
                              <ColumnConstraints percentWidth="34" />
                              <ColumnConstraints percentWidth="20" />
                              <ColumnConstraints percentWidth="20" />
                              <ColumnConstraints percentWidth="10" />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints minHeight="22" />
                              <!-- 5 data rows sẽ được add động từ Controller -->
                           </rowConstraints>
                           <children>
                              <!-- Header row (row 0) — tĩnh, giữ nguyên -->
                              <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 10px;" text="Mã Phiên"    GridPane.columnIndex="0" GridPane.rowIndex="0" />
                              <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 10px;" text="Sản phẩm"   GridPane.columnIndex="1" GridPane.rowIndex="0" />
                              <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 10px;" text="Người thắng" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                              <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 10px;" text="Giá cuối"   GridPane.columnIndex="3" GridPane.rowIndex="0" />
                              <Label style="-fx-text-fill: #9CA3AF; -fx-font-size: 10px;" text="Trạng thái" GridPane.columnIndex="4" GridPane.rowIndex="0" />
                           </children>
                        </GridPane>
                     </children>
                  </VBox>
               </children>
            </HBox>

         </children>
      </VBox>
   </content>
</ScrollPane>
