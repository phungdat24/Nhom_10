<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1024.0" styleClass="root-pane" stylesheets="@../css/dashboard.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nhomX.example.controller.MyAuctionsController">

    <!-- ===== TOP: Header ===== -->
    <top>
        <HBox fx:id="header" alignment="CENTER_LEFT" spacing="16.0" styleClass="header">
            <padding><Insets bottom="12" left="20" right="20" top="12" /></padding>
            <HBox alignment="CENTER" spacing="10" styleClass="logo-box">
                <padding>
                    <Insets bottom="24" />
                </padding>
                <children>
                    <Label styleClass="logo-icon" text="🔨" textFill="RED" />
                    <Label styleClass="logo-text" text="AUCTION" />
                </children>
            </HBox>
            <Region prefHeight="40.0" prefWidth="100.0" />

            <!-- Spacer -->
            <Region prefHeight="40.0" prefWidth="60.0" HBox.hgrow="ALWAYS" />

            <!-- [CHƯA ĐĂNG NHẬP] Nút Đăng nhập -->
            <Button fx:id="btnLogin" onAction="#handleLogin" styleClass="btn-login" text="👤  Đăng nhập/Đăng ký" />

            <!-- [ĐÃ ĐĂNG NHẬP] HBox hiện tên user — ẩn mặc định -->
            <HBox fx:id="userInfoBox" alignment="CENTER" managed="false" spacing="10" visible="false">
                <Label fx:id="lblUsername" styleClass="username-label" text="👤  Tên người dùng" />
                <Button fx:id="btnLogout" onAction="#handleLogout" styleClass="btn-logout" text="Đăng xuất" />
            </HBox>

        </HBox>
    </top>

    <!-- ===== LEFT: Sidebar ===== -->
    <left>
        <VBox fx:id="sidebar" spacing="4" styleClass="sidebar">
            <padding><Insets bottom="20" left="12" right="12" top="20" /></padding>

            <!-- Navigation Buttons -->
            <Button fx:id="btnDashboard" maxWidth="Infinity" onAction="#handleDashboard" styleClass="nav-btn" text="🏠   Dashboard" />

            <Button fx:id="btnLiveAuction" maxWidth="Infinity" onAction="#handleLiveAuction" styleClass="nav-btn" text="🚩   Live Auction" />

            <Button fx:id="btnMyAuction" maxWidth="Infinity" onAction="#handleMyAuctions" styleClass="nav-btn, nav-btn-active" text="≡   My Auctions" />

            <Button fx:id="btnProfile" maxWidth="Infinity" onAction="#handleProfile" styleClass="nav-btn" text="👤   Profile" />

            <Button fx:id="btnSeller" maxWidth="Infinity" onAction="#handleSeller" styleClass="nav-btn" text="🏷   Seller" />
        </VBox>
    </left>

    <!-- ===== CENTER: Content Area ===== -->
    <!-- ===== CENTER: Content Area ===== -->
    <center>
        <ScrollPane fx:id="scrollArea" fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane" vbarPolicy="AS_NEEDED">
            <VBox spacing="20">
                <padding>
                    <Insets bottom="20" left="20" right="20" top="20" />
                </padding>

                <!-- 1. Bảng Tóm Tắt (Summary) -->
                <HBox alignment="CENTER_LEFT" spacing="30" style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 8; -fx-padding: 15;">
                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #3c2a1a;" text="Thống kê của bạn:" />
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #1976d2; -fx-font-weight: bold;" text="Đang tham gia: 3" />
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #cc0000; -fx-font-weight: bold;" text="Tổng tiền đang cược: 5,200,000 đ" />
                </HBox>

                <!-- 2. Thanh Tabs Phân Loại (Filters) -->
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Button style="-fx-background-color: #c9a227; -fx-text-fill: white;" styleClass="live-filter-btn" text="🔥 Đang diễn ra" />
                    <Button styleClass="tab-inactive-brown" text="🏆 Đã thắng" />
                    <Button styleClass="tab-inactive-brown" text="❌ Đã thua" />
                </HBox>

                <!-- 3. Khu Vực Chứa Các Thẻ (Grid) -->
                <FlowPane fx:id="contentArea" hgap="16" styleClass="content-area" vgap="16">
                    <!-- Các MyAuctionCard sẽ được load vào đây qua Java -->
                </FlowPane>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
