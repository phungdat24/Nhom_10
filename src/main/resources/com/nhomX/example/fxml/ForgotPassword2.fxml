<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="800.0" styleClass="main-root" stylesheets="@../css/login.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nhomX.example.controller.ForgotPasswordController2">
    <children>
        <HBox alignment="TOP_LEFT" pickOnBounds="false" StackPane.alignment="TOP_LEFT">
            <children>
                <HBox alignment="CENTER" maxHeight="100.0" onMouseClicked="#handleBackToHome" styleClass="vibo-home-btn">
                    <children>
                        <Label styleClass="vibo-logo-text" text="🔨" />
                        <Label styleClass="vibo-logo-text" text="Vibo" />
                    </children>
                    <HBox.margin>
                        <Insets right="30.0" top="30.0" />
                    </HBox.margin>
                </HBox>
            </children>
        </HBox>
        <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="400.0" spacing="25.0" styleClass="login-card" StackPane.alignment="CENTER">
            <children>
                <Label text="Đổi mật khẩu" textAlignment="CENTER" textFill="#f4f4f4">
                    <cursor>
                        <Cursor fx:constant="NONE" />
                    </cursor>
                    <font>
                        <Font name="System Bold Italic" size="28.0" />
                    </font>
                </Label>
            <HBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="45.0" prefWidth="320.0" style="-fx-background-color: rgba(255, 255, 255, 0.1);" styleClass="input-field-container">
               <children>
                  <TextField fx:id="userName" prefHeight="45.0" prefWidth="250.0" promptText="Email" styleClass="text-field" />
               </children>
            </HBox>
                <HBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="45.0" prefWidth="320.0" style="-fx-background-color: rgba(255, 255, 255, 0.1);" styleClass="input-field-container">
                    <children>
                        <TextField fx:id="newPassword" prefHeight="45.0" prefWidth="250.0" promptText="Mật khẩu mới" styleClass="text-field" />
                    </children>
                </HBox>
                <HBox fx:id="confirmNewPassword" alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="45.0" prefWidth="320.0" spacing="10.0" style="-fx-background-color: rgba(255, 255, 255, 0.1);;" styleClass="input-field-container">
                    <children>
                        <TextField fx:id="account" minHeight="-Infinity" prefHeight="45.0" prefWidth="250.0" promptText="Xác nhận mật khẩu mới" />
                    </children>
                </HBox>
                <Button alignment="CENTER" mnemonicParsing="false" onAction="#confirm" prefHeight="40.0" prefWidth="300.0" styleClass="btn-login" text="Xác nhận">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>
            </children>
        </VBox>
    </children>
</StackPane>
