<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<!--
    BƯỚC 3 / 3 — Đặt mật khẩu mới
    Luồng: ForgotPassword_Email → OTPContent → [Mật khẩu mới]
    Controller: com.nhomX.example.controller.ForgotPasswordNewPasswordController
-->

<StackPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #2b1f12;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nhomX.example.controller.ForgotPwNewController">

    <!-- ===== BACKGROUND GLOW ===== -->
    <Circle fill="rgba(201,162,39,0.06)" radius="300" strokeWidth="0" translateX="-80" translateY="-80" StackPane.alignment="TOP_LEFT" />
    <Circle fill="rgba(201,162,39,0.04)" radius="250" strokeWidth="0" translateX="80" translateY="80" StackPane.alignment="BOTTOM_RIGHT" />

    <!-- ===== LOGO TOP-LEFT ===== -->
    <HBox alignment="TOP_LEFT" pickOnBounds="false" StackPane.alignment="TOP_LEFT" />

    <!-- ===== STEP INDICATOR TOP-RIGHT (step 3 active) ===== -->
    <HBox alignment="CENTER" spacing="8" StackPane.alignment="TOP_RIGHT">
        <StackPane.margin><Insets right="30" top="38" /></StackPane.margin>
        <!-- Step 1 - done -->
        <StackPane prefHeight="28" prefWidth="28" style="-fx-background-color: rgba(201,162,39,0.40); -fx-background-radius: 14;">
            <Label style="-fx-text-fill: #c9a227; -fx-font-size: 12px;" text="✓" />
        </StackPane>
        <Region prefHeight="2" prefWidth="24" style="-fx-background-color: rgba(201,162,39,0.35);" />
        <!-- Step 2 - done -->
        <StackPane prefHeight="28" prefWidth="28" style="-fx-background-color: rgba(201,162,39,0.40); -fx-background-radius: 14;">
            <Label style="-fx-text-fill: #c9a227; -fx-font-size: 12px;" text="✓" />
        </StackPane>
        <Region prefHeight="2" prefWidth="24" style="-fx-background-color: rgba(201,162,39,0.35);" />
        <!-- Step 3 - active -->
        <StackPane prefHeight="28" prefWidth="28" style="-fx-background-color: #c9a227; -fx-background-radius: 14;">
            <Label style="-fx-text-fill: #2b1f12; -fx-font-weight: bold; -fx-font-size: 12px;" text="3" />
        </StackPane>
    </HBox>

    <!-- ===== MAIN CARD ===== -->
    <VBox alignment="CENTER" maxWidth="440.0" minWidth="380.0" spacing="0" style="-fx-background-color: #3c2a1a; -fx-background-radius: 20; -fx-border-color: rgba(201,162,39,0.30); -fx-border-radius: 20; -fx-border-width: 1.5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.55), 40, 0, 0, 12);" StackPane.alignment="CENTER">

        <!-- Gold accent top bar -->
        <Region maxWidth="Infinity" minHeight="4.0" style="-fx-background-color: linear-gradient(to right, #c9a227, #e8c84a, #c9a227); -fx-background-radius: 20 20 0 0;" />

        <VBox alignment="CENTER" spacing="22">
            <padding><Insets bottom="36" left="36" right="36" top="32" /></padding>

            <!-- ICON AREA -->
            <AnchorPane maxWidth="-Infinity" minHeight="90" minWidth="90" prefHeight="90" prefWidth="90">
                <Circle centerX="45" centerY="45" fill="rgba(201,162,39,0.10)" radius="44" style="-fx-stroke: rgba(201,162,39,0.25); -fx-stroke-width: 1.5;" />
                <Circle centerX="45" centerY="45" fill="rgba(201,162,39,0.18)" radius="34" />
                <Label layoutX="26" layoutY="22" style="-fx-text-fill: #c9a227; -fx-font-size: 30px;" text="🛡" AnchorPane.leftAnchor="26.0" AnchorPane.topAnchor="22.0" />
                <!-- Badge xanh góc phải dưới -->
                <StackPane prefHeight="22" prefWidth="22" style="-fx-background-color: #2e7d32; -fx-background-radius: 11;" AnchorPane.bottomAnchor="0" AnchorPane.rightAnchor="0">
                    <Label style="-fx-text-fill: white; -fx-font-size: 10px; -fx-font-weight: bold;" text="✓" />
                </StackPane>
            </AnchorPane>

            <!-- TITLE + DESCRIPTION -->
            <VBox alignment="CENTER" spacing="8">
                <Label style="-fx-text-fill: #c9a227; -fx-font-size: 22px; -fx-font-weight: bold;" text="Đặt mật khẩu mới" />
                <Label alignment="CENTER" style="-fx-text-fill: rgba(255,220,160,0.75); -fx-font-size: 13px; -fx-text-alignment: center; -fx-wrap-text: true; -fx-max-width: 320;" text="Mật khẩu mới phải có ít nhất 6 ký tự." />
            </VBox>

            <!-- NEW PASSWORD INPUT -->
            <VBox maxWidth="Infinity" spacing="8">
                <Label style="-fx-text-fill: rgba(255,220,160,0.65); -fx-font-size: 12px; -fx-font-weight: bold;" text="MẬT KHẨU MỚI" />
                <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="10" style="-fx-background-color: #2b1f12; -fx-background-radius: 10; -fx-border-color: rgba(201,162,39,0.40); -fx-border-radius: 10; -fx-border-width: 1.5; -fx-padding: 0 12 0 12;">
                    <Label style="-fx-text-fill: #c9a227; -fx-font-size: 16px;" text="🔒" />

                    <PasswordField fx:id="newPasswordField" maxWidth="Infinity" HBox.hgrow="ALWAYS" prefHeight="48" prefWidth="280.0" promptText="Nhập mật khẩu mới" style="-fx-background-color: transparent; -fx-text-fill: #f4e8c8; -fx-prompt-text-fill: rgba(255,220,160,0.35); -fx-font-size: 14px; -fx-border-width: 0;" />
                    <TextField fx:id="newPasswordVisible" managed="false" visible="false" maxWidth="Infinity" HBox.hgrow="ALWAYS" prefHeight="48" prefWidth="280.0" promptText="Nhập mật khẩu mới" style="-fx-background-color: transparent; -fx-text-fill: #f4e8c8; -fx-prompt-text-fill: rgba(255,220,160,0.35); -fx-font-size: 14px; -fx-border-width: 0;" />

                    <Label fx:id="toggleNewPassword" onMouseClicked="#handleToggleNewPassword" style="-fx-text-fill: rgba(201,162,39,0.55); -fx-font-size: 14px; -fx-cursor: hand;" text="👁" />
                </HBox>
            </VBox>

            <!-- CONFIRM PASSWORD INPUT -->
            <VBox maxWidth="Infinity" spacing="8">
                <Label style="-fx-text-fill: rgba(255,220,160,0.65); -fx-font-size: 12px; -fx-font-weight: bold;" text="XÁC NHẬN MẬT KHẨU" />
                <HBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="10" style="-fx-background-color: #2b1f12; -fx-background-radius: 10; -fx-border-color: rgba(201,162,39,0.40); -fx-border-radius: 10; -fx-border-width: 1.5; -fx-padding: 0 12 0 12;">
                    <Label style="-fx-text-fill: #c9a227; -fx-font-size: 16px;" text="🔑" />
                    <PasswordField fx:id="confirmPasswordField" maxWidth="Infinity" prefHeight="48" prefWidth="280.0" promptText="Nhập lại mật khẩu mới" style="-fx-background-color: transparent; -fx-text-fill: #f4e8c8; -fx-prompt-text-fill: rgba(255,220,160,0.35); -fx-font-size: 14px; -fx-border-width: 0;" />
                    <Label fx:id="matchIndicator" style="-fx-font-size: 14px;" text="" />
                </HBox>
            </VBox>

            <!-- PASSWORD STRENGTH BAR -->
            <VBox maxWidth="Infinity" spacing="6">
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Label style="-fx-text-fill: rgba(255,220,160,0.50); -fx-font-size: 11px;" text="Độ mạnh:" />
                    <Label fx:id="lblStrength" style="-fx-text-fill: rgba(255,220,160,0.50); -fx-font-size: 11px; -fx-font-weight: bold;" text="—" />
                </HBox>
                <HBox spacing="4">
                    <Region fx:id="bar1" prefHeight="5" prefWidth="85" style="-fx-background-color: rgba(255,255,255,0.12); -fx-background-radius: 3;" />
                    <Region fx:id="bar2" prefHeight="5" prefWidth="85" style="-fx-background-color: rgba(255,255,255,0.12); -fx-background-radius: 3;" />
                    <Region fx:id="bar3" prefHeight="5" prefWidth="85" style="-fx-background-color: rgba(255,255,255,0.12); -fx-background-radius: 3;" />
                    <Region fx:id="bar4" prefHeight="5" prefWidth="85" style="-fx-background-color: rgba(255,255,255,0.12); -fx-background-radius: 3;" />
                </HBox>
            </VBox>

            <!-- ERROR LABEL -->
            <Label fx:id="lblError" managed="false" style="-fx-text-fill: #ff4444; -fx-font-size: 12px; -fx-font-weight: bold;" text="Mật khẩu xác nhận không khớp." visible="false" />

            <!-- CONFIRM BUTTON -->
            <Button fx:id="btnConfirm" maxWidth="Infinity" onAction="#handleConfirmNewPassword" style="-fx-background-color: linear-gradient(to bottom, #d4aa2e, #c9a227); -fx-text-fill: #2b1f12; -fx-font-weight: bold; -fx-font-size: 15px; -fx-background-radius: 10; -fx-padding: 14 0 14 0; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(201,162,39,0.35), 12, 0, 0, 3);" text="✔   Xác nhận đổi mật khẩu" />

            <!-- BACK TO LOGIN -->
            <Hyperlink onAction="#handleBackToLogin" style="-fx-text-fill: rgba(255,220,160,0.60); -fx-font-size: 13px; -fx-border-width: 0; -fx-underline: true; -fx-cursor: hand;" text="← Quay lại đăng nhập" />

            <!-- FOOTER TRUST BADGES -->
            <HBox alignment="CENTER" spacing="14">
                <Label style="-fx-text-fill: rgba(201,162,39,0.38); -fx-font-size: 10px;" text="🔒  SECURE" />
                <Label style="-fx-text-fill: rgba(201,162,39,0.22); -fx-font-size: 10px;" text="•" />
                <Label style="-fx-text-fill: rgba(201,162,39,0.38); -fx-font-size: 10px;" text="🛡  ENCRYPTED" />
                <Label style="-fx-text-fill: rgba(201,162,39,0.22); -fx-font-size: 10px;" text="•" />
                <Label style="-fx-text-fill: rgba(201,162,39,0.38); -fx-font-size: 10px;" text="⚡  VERIFIED" />
            </HBox>
        </VBox>
    </VBox>
    <!-- ===== END CARD ===== -->

</StackPane>
