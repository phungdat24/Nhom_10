<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fx:id="scrollArea" prefHeight="700.0" prefWidth="800.0" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            stylesheets="@../css/dashboard.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nhomX.example.controller.LiveAuctionController">
    <VBox alignment="CENTER">
        <children>
            <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="live-filter-bar">
                <padding><Insets bottom="15.0" left="30.0" right="30.0" top="15.0" /></padding>
                <children>
                    <Button onAction="#handleCategory" prefHeight="40.0" styleClass="live-filter-btn" text="🛒 Danh mục" />
                    <HBox alignment="CENTER_LEFT" maxWidth="600.0" styleClass="live-search-box" HBox.hgrow="ALWAYS">
                        <padding><Insets left="15.0" right="15.0" /></padding>
                        <children>
                            <TextField fx:id="txtSearch" prefHeight="40.0" promptText="🔍  Tìm kiếm sản phẩm..." styleClass="live-search-field" HBox.hgrow="ALWAYS" />
                        </children>
                    </HBox>
                    <Button onAction="#handleFilter" prefHeight="40.0" styleClass="live-filter-btn" text="⏳ Bộ lọc" />
                </children>
            </HBox>
            <VBox>
                <VBox.margin><Insets left="30.0" top="15.0" /></VBox.margin>
                <children>
                    <Label fx:id="lblItem" styleClass="item-count-label" text="All item(0)" />
                </children>
            </VBox>
            <FlowPane fx:id="liveAuctionContainer" hgap="16" styleClass="content-area" vgap="16">
                <padding><Insets bottom="20" left="20" right="20" /></padding>
            </FlowPane>
        </children>
    </VBox>
</ScrollPane>