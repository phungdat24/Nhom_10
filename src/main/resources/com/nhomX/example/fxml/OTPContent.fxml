<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<StackPane prefHeight="600.0" prefWidth="860.0" style="-fx-background-color: #2b1f12;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nhomX.example.controller.shared.OTPContentController">

    <!-- ===== BACKGROUND DECORATION: subtle ambient glows ===== -->
    <Circle fill="rgba(201,162,39,0.06)" radius="300" strokeWidth="0" translateX="-80" translateY="-80" StackPane.alignment="TOP_LEFT" />
    <Circle fill="rgba(201,162,39,0.04)" radius="250" strokeWidth="0" translateX="80" translateY="80" StackPane.alignment="BOTTOM_RIGHT" />

    <!-- ===== NÚT QUAY LẠI ===== -->
    <Button fx:id="btnBack" onAction="#handleBack" style="-fx-background-color: rgba(201,162,39,0.12);                -fx-text-fill: #c9a227;                -fx-font-size: 13px;                -fx-font-weight: bold;                -fx-background-radius: 8;                -fx-border-color: rgba(201,162,39,0.30);                -fx-border-radius: 8;                -fx-border-width: 1;                -fx-padding: 8 16 8 12;                -fx-cursor: hand;" text="← Quay lại" StackPane.alignment="TOP_LEFT">
        <StackPane.margin>
            <Insets left="20" top="20" />
        </StackPane.margin>
    </Button>
    
    <!-- ===== MAIN CARD ===== -->
    <VBox alignment="CENTER" maxWidth="440.0" minWidth="380.0" spacing="0" style="-fx-background-color: #3c2a1a; -fx-background-radius: 20; -fx-border-color: rgba(201,162,39,0.30); -fx-border-radius: 20; -fx-border-width: 1.5; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.55), 40, 0, 0, 12);" StackPane.alignment="CENTER">

        <!-- Gold accent top bar -->
        <Region maxWidth="Infinity" minHeight="4.0" style="-fx-background-color: linear-gradient(to right, #c9a227, #e8c84a, #c9a227); -fx-background-radius: 20 20 0 0;" />

        <VBox alignment="CENTER" spacing="26">
            <padding><Insets bottom="36" left="36" right="36" top="32" /></padding>

            <!-- - ICON AREA - -->
            <AnchorPane maxWidth="-Infinity" minHeight="90" minWidth="90" prefHeight="90" prefWidth="90">
                <!-- Vòng ngoài -->
                <Circle centerX="45" centerY="45" fill="rgba(201,162,39,0.10)" radius="44" style="-fx-stroke: rgba(201,162,39,0.25); -fx-stroke-width: 1.5;" />
                <!-- Vòng trong -->
                <Circle centerX="45" centerY="45" fill="rgba(201,162,39,0.18)" radius="34" />
                <!-- Icon email -->
                <Label layoutX="31.0" layoutY="25.0" style="-fx-text-fill: #c9a227; -fx-font-size: 28px;" text="✉" AnchorPane.leftAnchor="31.0" AnchorPane.topAnchor="25.0" />
                <!-- Badge xanh góc phải dưới -->
                <StackPane prefHeight="22" prefWidth="22" style="-fx-background-color: #2e7d32; -fx-background-radius: 11;" AnchorPane.bottomAnchor="0" AnchorPane.rightAnchor="0">
                    <Label style="-fx-text-fill: white; -fx-font-size: 10px; -fx-font-weight: bold;" text="✓" />
                </StackPane>
            </AnchorPane>

            <!-- - TITLE + DESCRIPTION - -->
            <VBox alignment="CENTER" spacing="8">
                <Label fx:id="lblTitle" style="-fx-text-fill: #c9a227; -fx-font-size: 22px; -fx-font-weight: bold; " text="Xác thực Email" />
                <Label fx:id="lblDesc" alignment="CENTER" style="-fx-text-fill: rgba(255,220,160,0.75); -fx-font-size: 13px; -fx-text-alignment: center; -fx-wrap-text: true; -fx-max-width: 320;" text="Vui lòng nhập mã 6 số vừa được gửi tới email" />
                <Label fx:id="lblEmail" style="-fx-text-fill: #c9a227; -fx-font-size: 13px; -fx-font-weight: bold;" text="abc@example.com" />
            </VBox>

            <!-- - 6 OTP INPUT BOXES - -->
            <!-- Note for controller: wire each box to auto-advance focus on input -->
            <HBox alignment="CENTER" spacing="8">
                <TextField fx:id="otp1" maxWidth="52" minWidth="52" prefHeight="58" promptText="•" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #c9a227; -fx-background-color: #2b1f12; -fx-background-radius: 10; -fx-border-color: rgba(201,162,39,0.40); -fx-border-radius: 10; -fx-border-width: 1.5; -fx-alignment: center;" />
                <TextField fx:id="otp2" maxWidth="52" minWidth="52" prefHeight="58" promptText="•" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #c9a227; -fx-background-color: #2b1f12; -fx-background-radius: 10; -fx-border-color: rgba(201,162,39,0.40); -fx-border-radius: 10; -fx-border-width: 1.5; -fx-alignment: center;" />
                <TextField fx:id="otp3" maxWidth="52" minWidth="52" prefHeight="58" promptText="•" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #c9a227; -fx-background-color: #2b1f12; -fx-background-radius: 10; -fx-border-color: rgba(201,162,39,0.40); -fx-border-radius: 10; -fx-border-width: 1.5; -fx-alignment: center;" />



                <TextField fx:id="otp4" maxWidth="52" minWidth="52" prefHeight="58" promptText="•" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #c9a227; -fx-background-color: #2b1f12; -fx-background-radius: 10; -fx-border-color: rgba(201,162,39,0.40); -fx-border-radius: 10; -fx-border-width: 1.5; -fx-alignment: center;" />
                <TextField fx:id="otp5" maxWidth="52" minWidth="52" prefHeight="58" promptText="•" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #c9a227; -fx-background-color: #2b1f12; -fx-background-radius: 10; -fx-border-color: rgba(201,162,39,0.40); -fx-border-radius: 10; -fx-border-width: 1.5; -fx-alignment: center;" />
                <TextField fx:id="otp6" maxWidth="52" minWidth="52" prefHeight="58" promptText="•" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #c9a227; -fx-background-color: #2b1f12; -fx-background-radius: 10; -fx-border-color: rgba(201,162,39,0.40); -fx-border-radius: 10; -fx-border-width: 1.5; -fx-alignment: center;" />
            </HBox>

            <!-- - ERROR MESSAGE - -->
            <Label fx:id="lblError" managed="false" style="-fx-text-fill: #ff4444; -fx-font-size: 12px; -fx-font-weight: bold;" text="Mã OTP không chính xác hoặc đã hết hạn." visible="false" />

            <!-- - CONFIRM BUTTON - -->
            <Button fx:id="btnConfirm" maxWidth="Infinity" onAction="#handleConfirmOtp" style="-fx-background-color: linear-gradient(to bottom, #d4aa2e, #c9a227); -fx-text-fill: #2b1f12; -fx-font-weight: bold; -fx-font-size: 15px; -fx-background-radius: 10; -fx-padding: 14 0 14 0; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(201,162,39,0.35), 12, 0, 0, 3);" text="✔   Xác nhận" />

            <!-- - RESEND AREA - -->
            <HBox alignment="CENTER" spacing="6">
                <!-- Timer label (shown while countdown active) -->
                <Label style="-fx-text-fill: rgba(255,220,160,0.50); -fx-font-size: 12px;" text="⏱" />
                <Label fx:id="lblResendTimer" style="-fx-text-fill: rgba(255,220,160,0.50); -fx-font-size: 12px;" text="Gửi lại sau 60s" />
                <!-- Resend button (hidden while timer ticks, shown after) -->
                <Hyperlink fx:id="btnResend" managed="false" onAction="#handleResendOtp" style="-fx-text-fill: #c9a227; -fx-font-size: 12px; -fx-font-weight: bold; -fx-border-width: 0; -fx-padding: 0; -fx-underline: true; -fx-cursor: hand;" text="Gửi lại ngay" visible="false" />
            </HBox>

            <!-- - FOOTER TRUST BADGES - -->
            <HBox alignment="CENTER" spacing="14">
                <Label style="-fx-text-fill: rgba(201,162,39,0.38); -fx-font-size: 10px;" text="🔒  SECURE" />
                <Label style="-fx-text-fill: rgba(201,162,39,0.22); -fx-font-size: 10px;" text="•" />
                <Label style="-fx-text-fill: rgba(201,162,39,0.38); -fx-font-size: 10px;" text="🛡  ENCRYPTED" />
                <Label style="-fx-text-fill: rgba(201,162,39,0.22); -fx-font-size: 10px;" text="•" />
                <Label style="-fx-text-fill: rgba(201,162,39,0.38); -fx-font-size: 10px;" text="⚡  VERIFIED" />
            </HBox>

        </VBox>
    </VBox>
    <!-- ===== END CARD ===== -->

</StackPane>
