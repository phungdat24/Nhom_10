<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="1024.0" styleClass="root-pane" stylesheets="@../css/dashboard.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.nhomX.example.controller.MainDashBoardController">

   <!-- ===== TOP: Header ===== -->
   <top>
      <HBox fx:id="header" alignment="CENTER_LEFT" spacing="16.0" styleClass="header">
         <padding><Insets bottom="12" left="20" right="20" top="12" /></padding>
         <HBox alignment="CENTER" spacing="10" styleClass="logo-box">
            <padding>
               <Insets bottom="24" />
            </padding>
            <children>
               <Button fx:id="btnHamburger" mnemonicParsing="false" onAction="#toggleSidebar"
                       style="-fx-background-color: white;
               -fx-border-color: rgba(201,162,39,0.30);
               -fx-border-radius: 8;
               -fx-border-width: 1;
               -fx-background-radius: 8;
               -fx-cursor: hand;
               -fx-padding: 6 10 6 10;"
                       text="☰">
                  <font><Font name="System Bold" size="18.0" /></font>
               </Button>
               <Label styleClass="logo-icon" text="🔨" textFill="rgb(155, 80, 199)" />
               <Label styleClass="logo-text" text="Vibo" />
            </children>
         </HBox>
         <Region prefHeight="40.0" prefWidth="100.0" />

         <!-- Spacer -->
         <Region prefHeight="40.0" prefWidth="60.0" HBox.hgrow="ALWAYS" />

         <!-- [CHƯA ĐĂNG NHẬP] Nút Đăng nhập -->
         <Button fx:id="btnLogin" onAction="#handleLogin" styleClass="btn-login" text="👤  Đăng nhập/Đăng ký" />

         <!-- [ĐÃ ĐĂNG NHẬP] HBox hiện tên user — ẩn mặc định -->
         <HBox fx:id="userInfoBox" alignment="CENTER" spacing="10"
               managed="false" visible="false"
               style="-fx-background-color: rgba(201,162,39,0.10);
             -fx-background-radius: 20;
             -fx-border-color: rgba(201,162,39,0.28);
             -fx-border-radius: 20;
             -fx-border-width: 1;
             -fx-padding: 6 14 6 8;">

            <!-- Avatar circle -->
            <StackPane minWidth="30" minHeight="30"
                       style="-fx-background-color: #c9a227;
                      -fx-background-radius: 15;">
               <Label fx:id="lblAvatarInitial"
                      text="U"
                      style="-fx-text-fill: #2b1f12;
                      -fx-font-size: 13px;
                      -fx-font-weight: bold;" />
            </StackPane>

            <!-- Tên người dùng -->
            <Label fx:id="lblUserName"
                   text="Người dùng"
                   style="-fx-text-fill: #c9a227;
                  -fx-font-size: 13px;
                  -fx-font-weight: bold;" />

            <!-- Dropdown arrow + menu -->
            <MenuButton fx:id="menuUser" mnemonicParsing="false" text="▾"
                        style="-fx-background-color: transparent;
                       -fx-text-fill: rgba(201,162,39,0.70);
                       -fx-font-size: 13px;
                       -fx-padding: 0 0 0 0;
                       -fx-border-width: 0;
                       -fx-cursor: hand;">
               <items>
                  <MenuItem fx:id="menuProfile" mnemonicParsing="false"
                            onAction="#handleProfile" text="👤  Hồ sơ của tôi" />
                  <MenuItem mnemonicParsing="false"
                            onAction="#handleLogout" text="🚪  Đăng xuất" />
               </items>
            </MenuButton>
         </HBox>

      </HBox>
   </top>

   <!-- ===== LEFT: Sidebar ===== -->
   <left>
      <VBox fx:id="sidebar" prefWidth="220.0" spacing="4" styleClass="sidebar">
         <padding>
            <Insets bottom="20" left="12" right="12" top="20" />
         </padding>
         <padding><Insets bottom="20" left="12" right="12" top="20" /></padding>

         <!-- Navigation Buttons -->
         <Button fx:id="btnDashboard" maxWidth="Infinity" onAction="#handleDashboard" styleClass="nav-btn, nav-btn-active" text="🏠   Dashboard" />

         <Button fx:id="btnLiveAuction" maxWidth="Infinity" onAction="#handleLiveAuction" styleClass="nav-btn" text="🚩   Live Auction" />

         <Button fx:id="btnMyAuction" maxWidth="Infinity" onAction="#handleMyAuctions" styleClass="nav-btn" text="≡   My Auctions" />

         <Button fx:id="btnSeller" maxWidth="Infinity" onAction="#handleSeller" styleClass="nav-btn" text="🏷   Seller" />
      </VBox>
   </left>

   <!-- ===== CENTER: Content Area ===== -->
   <center>
      <StackPane fx:id="mainContentArea">
         <padding>
            <Insets bottom="10" left="10" right="10" top="10" />
         </padding>
      </StackPane>
   </center>

</BorderPane>
