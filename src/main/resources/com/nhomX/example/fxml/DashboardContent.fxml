<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.Button?>

<ScrollPane fx:id="scrollArea" prefHeight="700.0" prefWidth="800.0" fitToWidth="true" hbarPolicy="NEVER" styleClass="scroll-pane" vbarPolicy="AS_NEEDED"
            stylesheets="@../css/dashboard.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nhomX.example.controller.DashboardContentController">
    <VBox alignment="CENTER">
        <children>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="50.0">
                <children>
                    <VBox alignment="CENTER" prefHeight="200.0" prefWidth="150.0">
                        <padding><Insets bottom="10.0" left="30.0" right="30.0" top="10.0" /></padding>
                        <children>
                            <Label styleClass="stat-icon" text="🔨" />
                            <Label fx:id="lblActiveAuctions" styleClass="stat-number" text="0" />
                            <Label styleClass="stat-label" text="Đang diễn ra" />
                        </children>
                    </VBox>
                    <VBox alignment="CENTER" prefHeight="200.0" prefWidth="150.0">
                        <padding><Insets bottom="10.0" left="30.0" right="30.0" top="10.0" /></padding>
                        <children>
                            <Label styleClass="stat-icon" text="⏳" />
                            <Label fx:id="lblEndingSoon" styleClass="stat-number" text="0" />
                            <Label styleClass="stat-label" text="Sắp kết thúc" />
                        </children>
                    </VBox>
                    <VBox alignment="CENTER" prefHeight="200.0" prefWidth="150.0">
                        <padding><Insets bottom="10.0" left="30.0" right="30.0" top="10.0" /></padding>
                        <children>
                            <Label styleClass="stat-icon" text="👥" />
                            <Label fx:id="lblTotalUsers" styleClass="stat-number" text="0" />
                            <Label minWidth="-Infinity" styleClass="stat-label" text="Người tham gia" />
                        </children>
                    </VBox>
                </children>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="20" styleClass="featured-card">
                <padding><Insets bottom="16" left="20" right="20" top="16" /></padding>
                <ImageView fx:id="imgFeatured" fitHeight="130" fitWidth="180" preserveRatio="true" />
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label styleClass="featured-tag" text="🏆  SẢN PHẨM NỔI BẬT" />
                    <Label fx:id="lblFeaturedName" styleClass="featured-name" text="Tên sản phẩm..." />
                    <Label fx:id="lblFeaturedPrice" styleClass="featured-price" text="Giá hiện tại: 0 VNĐ" />
                    <Label fx:id="lblFeaturedTime" styleClass="featured-time" text="⏱  Còn lại: 00:00:00" />
                </VBox>
                <VBox alignment="CENTER" spacing="8">
                    <Button onAction="#handleFeaturedBid" prefWidth="130" styleClass="btn-bidTransaction" text="Đấu giá ngay" />
                    <Button onAction="#handleFeaturedDetail" prefWidth="130" styleClass="btn-detail" text="Xem chi tiết" />
                </VBox>
            </HBox>

            <Label alignment="CENTER" styleClass="section-title" text="🔥  Đang diễn ra">
                <padding><Insets bottom="16.0" left="20.0" right="20.0" top="16.0" /></padding>
            </Label>

            <FlowPane fx:id="contentArea" hgap="16" styleClass="content-area" vgap="16">
                <padding><Insets bottom="20" left="20" right="20" /></padding>
            </FlowPane>
        </children>
    </VBox>
</ScrollPane>